---
import { getLatestPosts } from "../../lib/contentful";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/brand/PageHero.astro";
import { format } from "date-fns";
import { es } from "date-fns/locale";

const posts = (await getLatestPosts(12)).map((item) => {
  const { title, slug, date, headerImg, description, category, readTime } = item.fields;
  return {
    title,
    slug,
    date: date ? new Date(date) : new Date(),
    image: headerImg && "fields" in headerImg ? headerImg.fields.file?.url : undefined,
    description,
    category: category || "Noticias",
    readTime: readTime || "5",
  };
});

const [featured, ...rest] = posts;
---

<Layout title="Noticias | TARS Robotics UPV">
  <Header />
  <PageHero
    eyebrow="Actualidad"
    title="Noticias"
    description="Las noticias y avances más recientes del equipo."
  />

  <main class="mx-auto max-w-6xl px-6 pt-20">
    {
      featured && (
        <a href={`/work/${featured.slug}`} class="group grid lg:grid-cols-2 gap-8 lg:gap-12 items-center rounded-xl bg-[#181818] border border-zinc-800/30 p-6 mb-16">
          <div class="overflow-hidden aspect-[16/10] bg-tars-50">
            {featured.image && (
              <img src={featured.image} alt="" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            )}
          </div>
          <div class="flex flex-col gap-4">
            <p class="text-xs uppercase tracking-[0.15em] text-tars">
              Destacado · {featured.category} · {format(featured.date, "d 'de' MMMM, yyyy", { locale: es })} · {featured.readTime} min
            </p>
            <h2 class="font-display font-extrabold text-3xl md:text-4xl leading-tight group-hover:text-tars transition-colors">
              {featured.title}
            </h2>
            {featured.description && <p class="text-lg text-ink/75 line-clamp-3">{featured.description}</p>}
            <span class="inline-flex items-center gap-2 text-tars font-medium">
              Leer artículo
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
              </svg>
            </span>
          </div>
        </a>
      )
    }

    {
      rest.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
          {rest.map((post) => (
            <a href={`/work/${post.slug}`} class="group flex flex-col gap-4">
              <div class="overflow-hidden aspect-[4/3] bg-tars-50">
                {post.image && (
                  <img src={post.image} alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                )}
              </div>
              <p class="text-xs uppercase tracking-wide text-tars">
                {post.category} · {format(post.date, "d MMM yyyy", { locale: es })} · {post.readTime} min
              </p>
              <h3 class="text-xl font-semibold leading-snug group-hover:text-tars transition-colors line-clamp-2">{post.title}</h3>
              {post.description && <p class="text-ink/75 text-sm line-clamp-3">{post.description}</p>}
            </a>
          ))}
        </div>
      )
    }

    {
      posts.length === 0 && (
        <div class="py-20 text-center flex flex-col items-center gap-4">
          <img src="/img/brand/mascota-circulo.png" alt="" class="h-20 w-auto" />
          <h2 class="font-display font-extrabold uppercase text-2xl text-tars">Próximamente nuevas publicaciones</h2>
          <p class="text-ink/70">Estamos preparando contenido nuevo sobre el equipo y nuestros robots.</p>
        </div>
      )
    }
  </main>

  <Footer />
</Layout>
