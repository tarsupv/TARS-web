---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/brand/PageHero.astro";
import SectionTitle from "../../components/brand/SectionTitle.astro";
import BrandButton from "../../components/brand/BrandButton.astro";
import Tutorials from "../../../public/json/tutorials.json";

const workshops = Tutorials.workshops || [];
const teacherCommunity = Tutorials.teacherCommunity;

const getYouTubeVideoId = (url: string) => {
  if (!url) return null;
  try {
    const parsed = new URL(url);
    const host = parsed.hostname.replace("www.", "");
    const path = parsed.pathname;
    if (host === "youtu.be") return path.slice(1).split("/")[0] || null;
    if (host === "youtube.com" || host === "m.youtube.com") {
      if (path === "/watch") return parsed.searchParams.get("v");
      if (path.startsWith("/shorts/")) return path.split("/")[2] || null;
    }
    return null;
  } catch {
    return null;
  }
};

const resources = [
  {
    eyebrow: "Recursos para docentes",
    title: "Descarga la librería preparada por TARS",
    text: "Una librería lista para usar en clase y en la competición. Descarga el paquete más reciente desde GitHub e incorpóralo directamente a vuestros proyectos de UN Robotics.",
    cta: "Descargar librería",
    href: "https://github.com/UPV-TARS/UN-Robotics/releases/latest/download/TARS.zip",
  },
  {
    eyebrow: "Control del robot",
    title: "Descarga la aplicación Android",
    text: "La APK oficial para controlar el robot desde un dispositivo Android. Descárgala y úsala durante las pruebas y la competición.",
    cta: "Descargar APK",
    href: "https://drive.google.com/file/d/1RRGvoXQ9Q7XJcsCXN9pn9xOktdNoo7wa/view?usp=sharing",
  },
];
---

<Layout
  title="UN Robotics | TARS Robotics UPV"
  description="Tutoriales y recursos de TARS UPV para la competición de robótica de la ONU."
 
>
  <Header />
  <PageHero
    eyebrow="Colaboración con Naciones Unidas"
    title="UN Robotics"
    description="Tutoriales y recursos para preparar la UN Robotics Competition."
  />

  <main class="mx-auto max-w-6xl px-6 pt-20 flex flex-col gap-24">
    <p class="text-lg sm:text-xl leading-relaxed max-w-4xl">
      Esta colaboración entre <span class="text-tars">TARS Robotics UPV</span> y el
      <span class="text-tars">United Nations Global Service Center</span> en Valencia apoya a la
      comunidad de la UN Robotics Competition con tutoriales de hardware y software para que
      docentes y estudiantes diseñen y construyan su propio robot, además de un grupo de
      WhatsApp donde resolver dudas con ayuda directa de nuestro equipo.
    </p>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        resources.map((r) => (
          <div class="rounded-xl bg-[#181818] border border-zinc-800/30 p-6 flex flex-col gap-4">
            <p class="text-tars text-xs font-semibold uppercase tracking-[0.15em]">{r.eyebrow}</p>
            <h2 class="font-display font-extrabold text-2xl">{r.title}</h2>
            <p class="leading-relaxed text-ink/80">{r.text}</p>
            <div class="mt-auto pt-2">
              <BrandButton href={r.href} external>{r.cta}</BrandButton>
            </div>
          </div>
        ))
      }
    </section>

    <section>
      <SectionTitle
        id="tutoriales"
        eyebrow="Formación"
        title="Tutoriales oficiales"
        link={{ href: Tutorials.featuredChannelUrl, label: "Ver canal de YouTube" }}
      />
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-8 gap-y-12">
        {
          workshops.map((workshop) => {
            const videoId = getYouTubeVideoId(workshop.youtubeUrl);
            return (
              <article class="flex flex-col gap-4">
                {videoId ? (
                  <iframe
                    class="w-full aspect-video bg-tars-50"
                    src={`https://www.youtube-nocookie.com/embed/${videoId}`}
                    title={workshop.title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  />
                ) : (
                  <div class="w-full aspect-video bg-tars-50 flex items-center justify-center text-center px-6 text-sm text-ink/60">
                    Añade una URL directa de vídeo para mostrar el tutorial aquí.
                  </div>
                )}
                <p class="flex gap-2 text-xs">
                  <span class="bg-tars-50 text-tars px-3 py-1 uppercase tracking-wide">{workshop.level}</span>
                  <span class={`px-3 py-1 uppercase tracking-wide ${workshop.status === "Disponible" ? "bg-tars text-white" : "border border-tars-200 text-ink/60"}`}>
                    {workshop.status}
                  </span>
                </p>
                <h3 class="text-xl font-semibold leading-snug">{workshop.title}</h3>
                <p class="text-ink/75 line-clamp-3">{workshop.description}</p>
                <a href={workshop.youtubeUrl} target="_blank" rel="noopener noreferrer" class="text-tars text-sm underline underline-offset-4 w-fit">
                  Ver tutorial
                </a>
              </article>
            );
          })
        }
      </div>
    </section>

    <section class="rounded-2xl border border-emerald-400/20 bg-[radial-gradient(circle_at_top_left,_rgba(16,185,129,0.18),_transparent_35%),linear-gradient(135deg,_rgba(9,18,18,0.98),_rgba(9,9,11,0.96))] text-white px-8 py-10 grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-10 items-center">
      <div class="flex flex-col gap-4">
        <p class="font-wide uppercase tracking-[0.25em] text-white/80 text-sm">Docentes UN Robotics</p>
        <h2 class="font-display font-extrabold text-3xl">{teacherCommunity.title}</h2>
        <p class="leading-relaxed text-white/85">{teacherCommunity.description}</p>
        <ul class="mt-2 flex flex-col gap-2 text-white/85">
          <li class="flex gap-3"><span class="mt-2 w-2 h-2 shrink-0 bg-white" />Resuelve dudas sobre normativa, montaje, estrategia o entregables.</li>
          <li class="flex gap-3"><span class="mt-2 w-2 h-2 shrink-0 bg-white" />Recursos, recomendaciones y avisos importantes en un solo lugar.</li>
          <li class="flex gap-3"><span class="mt-2 w-2 h-2 shrink-0 bg-white" />Acompañamiento de TARS Robotics UPV durante toda la competición.</li>
        </ul>
      </div>
      <div class="rounded-2xl border border-white/10 bg-black/25 text-white p-6 flex flex-col gap-4">
        <p class="text-tars text-xs font-semibold uppercase tracking-[0.15em]">Accede a la comunidad</p>
        <p class="text-lg font-semibold">
          Rellena este formulario y te daremos acceso directo a la comunidad de profesores de WhatsApp.
        </p>
        <BrandButton href={teacherCommunity.url} external>{teacherCommunity.ctaLabel}</BrandButton>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
