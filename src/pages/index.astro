---
import { getLatestPosts } from "../lib/contentful";
import { headerSponsors } from "../lib/sponsors";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Rover from "../components/threejs.astro";
import SectionTitle from "../components/brand/SectionTitle.astro";
import BrandButton from "../components/brand/BrandButton.astro";
import Competitions from "../../public/json/competitions.json";
import InternalInitiatives from "../../public/json/internal_initiatives.json";
import { format } from "date-fns";
import { es } from "date-fns/locale";

const posts = (await getLatestPosts(3)).map((item) => {
  const { title, slug, date, headerImg, description, category, readTime } = item.fields;
  return {
    title,
    slug,
    date: date ? new Date(date) : null,
    image: headerImg && "fields" in headerImg ? headerImg.fields.file?.url : undefined,
    description,
    category: category || "Noticias",
    readTime: readTime || "5",
  };
});

const mainSponsors = headerSponsors();
const initiatives = InternalInitiatives.initiatives;
---

<Layout title="TARS Robotics | Robótica competitiva en la UPV">
  <Header />
  <main>
    <!-- Hero (visuales de la web antigua) -->
    <section id="top" class="old-hero-bg relative w-screen overflow-hidden rounded-b-lg pt-20">
      <iframe src="/html/particles.html" title="" tabindex="-1" class="pointer-events-none top-0 left-0 opacity-60 w-screen h-full absolute"></iframe>
      <div class="old-grid pointer-events-none left-0 top-0 w-screen h-full absolute"></div>
      <span class="parallax-text pointer-events-none bottom-32 -left-[60%] sm:-left-[10%] font-[Braille] text-[200px] text-white opacity-5 rotate-90 z-0 absolute">TARS</span>

      <div class="relative mx-auto max-w-7xl px-6 grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-center gap-6 min-h-[calc(100svh-11rem)] py-12 lg:py-0">
        <div class="flex flex-col items-start gap-3 z-20">
          <h1 class="mb-0 text-white flex flex-col items-start">
            <span class="font-wide uppercase tracking-[0.2em] sm:tracking-[0.35em] text-white/85 text-sm sm:text-base">Robótica competitiva · UPV</span>
            <span class="mt-4 flex items-center gap-5">
              <img src="/img/brand/wordmark-tars-robotics.png" alt="TARS Robotics" class="h-20 sm:h-28 w-auto" />
              <img src="/img/brand/mascota-circulo.png" alt="" class="h-16 sm:h-24 w-auto" />
            </span>
          </h1>
          <p class="mb-6 max-w-md text-lg sm:text-xl text-white/85 font-light leading-relaxed">
            Innovación y excelencia en robótica competitiva
          </p>
          <div class="flex flex-wrap gap-3">
            <BrandButton href="#sobre-nosotros">Descubre el equipo</BrandButton>
            <BrandButton href="/partners#patrocinadores">Patrocina</BrandButton>
          </div>
        </div>

        <Rover class="h-[380px] sm:h-[480px] lg:h-[600px] w-full" />
      </div>

      <!-- Patrocinadores principales: el nivel que el dossier coloca en la cabecera -->
      <div class="relative border-t border-white/10">
        <div class="mx-auto max-w-7xl px-6 py-5 flex flex-wrap items-center gap-x-10 gap-y-5">
          <img src="/img/brand/logo-upv-blanco.png" alt="Universitat Politècnica de València" class="h-10 w-auto opacity-90" />
          <img src="/img/brand/logo-generacion-espontanea-blanco.png" alt="Generación Espontánea · UPV Design Factory" class="h-10 w-auto opacity-90" />
          {
            mainSponsors.length > 0 && (
              <div class="flex flex-wrap items-center gap-4 lg:ml-auto">
                <span class="font-wide uppercase tracking-[0.2em] text-xs text-white/75">Patrocinadores principales</span>
                {mainSponsors.map((s) => (
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={s.name}
                    class="flex items-center h-14 rounded-lg bg-white px-4 opacity-90 hover:opacity-100 transition-opacity"
                  >
                    <img src={s.logo} alt={s.name} class="max-h-9 w-auto max-w-[170px] object-contain" />
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-6xl px-6 flex flex-col gap-28 pt-24">
      <!-- Noticias (Contentful). En local sin credenciales no hay posts y se omite. -->
      {
        posts.length > 0 && (
          <section>
            <SectionTitle id="noticias" eyebrow="Actualidad" title="Últimas noticias" link={{ href: "/work", label: "Ver todas las noticias" }} />
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              {posts.map((post) => (
                <a href={`/work/${post.slug}`} class="group flex flex-col gap-4 overflow-hidden rounded-xl bg-[#181818] border border-zinc-800/30 pb-5 hover:-translate-y-2 transition-all [&>*:not(:first-child)]:px-5">
                  <div class="overflow-hidden bg-tars-50 aspect-[4/3]">
                    {post.image && (
                      <img src={post.image} alt="" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                    )}
                  </div>
                  <p class="text-xs uppercase tracking-wide text-tars">
                    {post.category}
                    {post.date && ` · ${format(post.date, "d MMM yyyy", { locale: es })}`}
                    {` · ${post.readTime} min`}
                  </p>
                  <h3 class="text-xl font-semibold leading-snug group-hover:text-tars transition-colors">{post.title}</h3>
                  {post.description && <p class="text-ink/75 line-clamp-3">{post.description}</p>}
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- Sobre nosotros: resumen; el detalle vive en /team -->
      <section class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <SectionTitle id="sobre-nosotros" eyebrow="Equipo TARS" title="Sobre nosotros" />
          <p class="text-lg leading-relaxed text-ink/85">
            Somos un equipo multidisciplinar de <span class="text-tars">robótica competitiva</span>
            de la <span class="text-tars">Universitat Politècnica de València</span>, dentro del
            programa Generación Espontánea. Diseñamos, programamos y construimos robots para
            competir en eventos nacionales e internacionales, y nuestro proyecto principal es un
            rover autónomo de exploración planetaria para la European Rover Challenge.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <BrandButton href="/team">Conoce al equipo</BrandButton>
            <BrandButton href="/team#que-hacemos" variant="ghost">Qué hacemos</BrandButton>
          </div>
        </div>
        <img
          src="/img/brand/equipo-2026.webp"
          alt="El equipo TARS delante del arco de la Universitat Politècnica de València"
          class="w-full h-auto"
          loading="lazy"
        />
      </section>

      <!-- Competiciones -->
      <section>
        <SectionTitle id="competiciones" eyebrow="Próximos eventos" title={`Competiciones ${Competitions.season}`} />
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          {
            Competitions.competitions.map((c) => (
              <article class="flex flex-col gap-4 rounded-xl bg-[#181818] border border-zinc-800/30 p-6">
                <div class="h-24 flex items-center justify-center rounded-lg bg-white px-4">
                  <img src={c.logo} alt={c.title} class="max-h-16 w-auto max-w-[240px] object-contain" loading="lazy" />
                </div>
                <h3 class="text-xl font-semibold">{c.title}</h3>
                <p class="text-tars text-sm">{c.date} · {c.place}</p>
                <p class="text-ink/75 leading-relaxed">{c.description}</p>
                {c.link && (
                  <a href={c.link} target="_blank" rel="noopener noreferrer" class="mt-auto text-tars text-sm underline underline-offset-4 w-fit">
                    Web oficial
                  </a>
                )}
              </article>
            ))
          }
        </div>
        <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 rounded-xl bg-[#181818] border border-zinc-800/30">
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 px-6 sm:px-8 py-6">
            <span class="text-tars text-4xl whitespace-nowrap">3º de España</span>
            <span class="text-ink/75 text-sm">Lucha de robots de 1 lb · Robolid 2026</span>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 px-6 sm:px-8 py-6">
            <span class="text-tars text-4xl whitespace-nowrap">+100.000</span>
            <span class="text-ink/75 text-sm">visualizaciones en un mes en redes (abril de 2026)</span>
          </div>
        </div>
      </section>

      <!-- Iniciativas internas -->
      <section>
        <SectionTitle id="iniciativas" eyebrow="Mejoras del grupo" title="Iniciativas internas" />
        <p class="text-lg leading-relaxed max-w-3xl text-ink/85 -mt-2 mb-10">
          Talleres y dinámicas internas que usamos para reforzar habilidades técnicas,
          organización y rendimiento del equipo.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
          {
            initiatives.map((initiative) => (
              <a href={`/initiatives/${initiative.slug}`} class="group flex flex-col rounded-xl bg-[#181818] border border-zinc-800/30 hover:-translate-y-1 transition-all">
                <div class="overflow-hidden">
                  <img
                    src={initiative.image || "/img/defaultbg2.png"}
                    alt={initiative.title}
                    class="w-full aspect-[16/10] object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
                <div class="flex flex-col gap-3 p-6 flex-1">
                  <p class="text-xs uppercase tracking-wide text-tars">
                    {initiative.focus} · {initiative.frequency}
                  </p>
                  <h3 class="text-xl font-semibold group-hover:text-tars transition-colors">{initiative.title}</h3>
                  <p class="text-ink/75 line-clamp-3">{initiative.description}</p>
                  <div class="flex items-center gap-3 pt-3 mt-auto border-t border-tars-100">
                    <img src={initiative.leadImage} alt="" class="w-9 h-9 rounded-full object-cover" loading="lazy" />
                    <p class="text-sm"><span class="text-ink/60">Responsable:</span> {initiative.lead}</p>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <!-- Contacto -->
      <section class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div class="flex flex-col gap-6">
          <SectionTitle id="contacto" eyebrow="Escríbenos" title="Contacto" />
          <p class="text-lg leading-relaxed -mt-4">
            ¿Te gustaría formar parte del equipo o colaborar con nosotros? No dudes en contactarnos.
          </p>
          {
            [
              { label: "Dirección", value: "Garaje Casa de l'Alumne, Camino de Vera, s/n, 46022 Valencia", href: "https://maps.google.com/?q=Casa de l'Alumne, Camino de Vera" },
              { label: "Teléfono", value: "+34 722 158 786", href: "tel:+34722158786" },
              { label: "Email", value: "hola@tarsupv.com", href: "mailto:hola@tarsupv.com" },
            ].map((item) => (
              <a href={item.href} class="group border-l-4 border-tars pl-5 py-1 flex flex-col">
                <span class="text-xs uppercase tracking-wide text-tars">{item.label}</span>
                <span class="text-lg group-hover:text-tars transition-colors">{item.value}</span>
              </a>
            ))
          }
        </div>
        <iframe
          class="w-full h-80 lg:h-full min-h-80 rounded-xl bg-[#181818] border border-zinc-800/30"
          title="Mapa: Casa de l'Alumne, UPV"
          loading="lazy"
          src="https://www.openstreetmap.org/export/embed.html?bbox=-0.34337371587753296%2C39.47991812377764%2C-0.34047693014144903%2C39.48158673031113&layer=mapnik&marker=39.48075243204821%2C-0.34192532300949097"
        ></iframe>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  // Texto "TARS" en Braille con paralaje, como en la web antigua.
  const parallaxText = document.querySelector<HTMLElement>(".parallax-text");
  window.addEventListener("scroll", () => {
    if (parallaxText) parallaxText.style.transform = `translateY(${window.scrollY * 0.3}px) rotate(90deg)`;
  }, { passive: true });
</script>
