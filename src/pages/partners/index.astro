---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/brand/PageHero.astro";
import SectionTitle from "../../components/brand/SectionTitle.astro";
import SponsorTiers from "../../components/brand/SponsorTiers.astro";
import BrandButton from "../../components/brand/BrandButton.astro";
import { enlace_ser_patrocinador, enlace_dossier_patrocinio } from "../../lib/constants";
import EntitiesData from "../../../public/json/entities.json";

interface Entity {
  name: string;
  logo?: string;
  whatTheyDo?: string;
  collaboration?: string;
  url?: string;
}

const entities = (EntitiesData.entities || []) as Entity[];
---

<Layout title="Partners | TARS Robotics UPV">
  <Header />
  <PageHero
    eyebrow="Quiénes nos apoyan"
    title="Partners"
    description="Las empresas e instituciones que impulsan TARS."
  >
    <nav class="mt-4 flex flex-wrap gap-3 text-sm">
      <a href="#patrocinadores" class="px-4 py-2 border border-white/60 hover:bg-white hover:text-black transition-colors">Patrocinadores</a>
      <a href="#entidades" class="px-4 py-2 border border-white/60 hover:bg-white hover:text-black transition-colors">Entidades</a>
    </nav>
  </PageHero>

  <main class="mx-auto max-w-6xl px-6 flex flex-col gap-28 pt-20">
    <section>
      <SectionTitle id="patrocinadores" eyebrow="Temporada 2026-27" title="Patrocinadores" />
      <p class="text-lg leading-relaxed max-w-3xl text-ink/85 -mt-2 mb-10">
        Las empresas e instituciones que apoyan nuestras ideas, prototipos y competiciones.
      </p>
      <div class="-mt-4 mb-10 flex flex-wrap gap-3">
        <BrandButton href={enlace_ser_patrocinador} variant="light">Ser patrocinador</BrandButton>
        <BrandButton href={enlace_dossier_patrocinio} external>Consigue el dossier</BrandButton>
      </div>
      <SponsorTiers detailed />
    </section>

    <section>
      <SectionTitle id="entidades" eyebrow="Colaboraciones institucionales" title="Entidades" />
      <p class="text-lg leading-relaxed max-w-3xl text-ink/85 -mt-2 mb-10">
        Organizaciones e instituciones que colaboran con TARS en iniciativas estratégicas.
      </p>
      <div class="flex flex-col gap-6">
        {
          entities.map((entity) => (
            <details class="entity rounded-xl bg-[#181818] border border-zinc-800/30 open:border-blue-500/40 transition-colors">
              <summary class="list-none cursor-pointer px-6 py-5 flex items-center justify-between gap-5">
                <div class="flex items-center gap-5">
                  {entity.logo && <img src={entity.logo} alt="" class="h-12 w-auto max-w-[160px] object-contain" loading="lazy" />}
                  <h3 class="text-xl font-semibold">{entity.name}</h3>
                </div>
                <span class="chevron text-tars text-3xl leading-none">+</span>
              </summary>
              <div class="px-6 pb-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="border-l-4 border-tars pl-5">
                  <h4 class="text-tars text-xs uppercase tracking-wide">Qué hacen</h4>
                  <p class="mt-2 leading-relaxed text-ink/80">{entity.whatTheyDo || "Información no disponible."}</p>
                </div>
                <div class="border-l-4 border-tars pl-5">
                  <h4 class="text-tars text-xs uppercase tracking-wide">Cómo colaboramos</h4>
                  <p class="mt-2 leading-relaxed text-ink/80">{entity.collaboration || "Información no disponible."}</p>
                </div>
                {entity.url && (
                  <a href={entity.url} target="_blank" rel="noopener noreferrer" class="text-tars underline underline-offset-4 w-fit">
                    Visitar sitio
                  </a>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .entity summary::-webkit-details-marker {
    display: none;
  }
  .chevron {
    transition: transform 0.2s ease;
  }
  .entity[open] .chevron {
    transform: rotate(45deg);
  }
</style>
