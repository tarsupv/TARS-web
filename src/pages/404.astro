---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/brand/PageHero.astro";
import BrandButton from "../components/brand/BrandButton.astro";
---

<Layout title="Página no encontrada | TARS Robotics UPV">
  <Header />
  <PageHero eyebrow="Error 404" title="Página no encontrada" />

  <main class="mx-auto max-w-6xl px-6 pt-20 flex flex-col sm:flex-row items-start sm:items-center gap-10">
    <img src="/img/brand/mascota-circulo.png" alt="" class="h-28 w-auto" />
    <div class="flex flex-col gap-5">
      <p class="text-lg leading-relaxed text-ink/80 max-w-xl">
        La página que buscas no existe o se ha movido. Ni el rover la encuentra sin mapa previo.
      </p>
      <div class="flex flex-wrap gap-3">
        <BrandButton href="/">Volver al inicio</BrandButton>
        <BrandButton href="/#contacto" variant="ghost">Contacto</BrandButton>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
