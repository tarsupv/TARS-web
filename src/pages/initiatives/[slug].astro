---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import DetailHero from "../../components/brand/DetailHero.astro";
import InitiativesData from "../../../public/json/internal_initiatives.json";

interface Initiative {
  slug: string;
  title: string;
  description: string;
  longDescription?: string[];
  lead: string;
  leadImage: string;
  image: string;
  gallery?: string[];
  focus: string;
  frequency: string;
  winnerNames?: string;
  winnerUrl?: string;
}

export async function getStaticPaths() {
  const initiatives = (InitiativesData.initiatives || []) as Initiative[];
  return initiatives.map((initiative) => ({
    params: { slug: initiative.slug },
    props: { initiative },
  }));
}

const { initiative } = Astro.props as { initiative: Initiative };
---

<Layout
  title={`${initiative.title} | Iniciativas internas`}
  description={initiative.description}
  image={initiative.image}
 
>
  <Header />
  <DetailHero
    image={initiative.image}
    title={initiative.title}
    eyebrow="Iniciativa interna"
    summary={initiative.description}
    tags={[initiative.focus, initiative.frequency]}
    back={{ href: "/#iniciativas", label: "Volver a iniciativas" }}
  />

  <main class="mx-auto max-w-6xl px-6 pt-16 flex flex-col gap-20">
    <section class="grid gap-12 lg:grid-cols-[1.5fr_1fr]">
      <article>
        <h2 class="font-display font-extrabold uppercase text-2xl mb-6">Sobre la iniciativa</h2>
        <div class="flex flex-col gap-5 text-lg leading-relaxed text-ink/85">
          {(initiative.longDescription || []).map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>

      <aside class="flex flex-col gap-10">
        <div class="flex items-center gap-4">
          <img src={initiative.leadImage} alt="" class="h-16 w-16 rounded-full object-cover border-2 border-tars" />
          <div>
            <p class="text-xs uppercase tracking-wide text-tars">Responsable</p>
            <p class="text-lg font-medium">{initiative.lead}</p>
          </div>
        </div>

        <div class="bg-tars-50 p-6 flex flex-col gap-4">
          <h2 class="text-tars text-xs font-semibold uppercase tracking-[0.15em]">Ficha rápida</h2>
          <div class="border-l-4 border-tars pl-4">
            <span class="block text-xs uppercase tracking-wide text-ink/55">Área</span>
            <span>{initiative.focus}</span>
          </div>
          <div class="border-l-4 border-tars pl-4">
            <span class="block text-xs uppercase tracking-wide text-ink/55">Estado</span>
            <span>{initiative.frequency}</span>
          </div>
          {initiative.winnerNames && (
            <div class="border-l-4 border-tars pl-4">
              <span class="block text-xs uppercase tracking-wide text-ink/55">Ganadores</span>
              <span>{initiative.winnerNames}</span>
              {initiative.winnerUrl && (
                <a href={initiative.winnerUrl} target="_blank" rel="noopener noreferrer" class="block mt-2 text-sm text-tars underline underline-offset-4">
                  Ver publicación ganadora
                </a>
              )}
            </div>
          )}
        </div>
      </aside>
    </section>

    {initiative.gallery && initiative.gallery.length > 0 && (
      <section>
        <h2 class="font-display font-extrabold uppercase text-2xl mb-6">Galería</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {initiative.gallery.map((image, index) => (
            <img src={image} alt={`${initiative.title}, imagen ${index + 1}`} class="w-full aspect-[4/3] object-cover" loading="lazy" />
          ))}
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>
