---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/brand/PageHero.astro";
import BrandButton from "../../components/brand/BrandButton.astro";
import WorkshopsData from "../../../public/json/workshops.json";

interface WorkshopPartner {
  name: string;
  role: string;
  logo?: string;
  url?: string;
}

interface Workshop {
  slug: string;
  title: string;
  category: string;
  status: string;
  date?: string;
  partner?: string;
  location?: string;
  schedule?: string;
  summary: string;
  heroImage: string;
  partners?: WorkshopPartner[];
  sponsors?: WorkshopPartner[];
}

const workshops = (WorkshopsData.workshops || []) as Workshop[];
---

<Layout
  title="Talleres | TARS Robotics UPV"
  description="Talleres y formaciones organizadas por TARS para compartir conocimientos técnicos y prácticos."
 
>
  <Header />
  <PageHero
    eyebrow="Formación TARS"
    title="Talleres"
    description="Las sesiones y formaciones que vamos organizando desde TARS."
  />

  <main class="mx-auto max-w-6xl px-6 pt-20 flex flex-col gap-16">
    <p class="text-lg sm:text-xl leading-relaxed max-w-4xl">
      No solo nos dedicamos a competir: también queremos acercar la
      <span class="text-tars">robótica competitiva</span> a los estudiantes de la UPV. Por eso
      organizamos talleres en los que los alumnos se acercan al diseño de un robot realmente
      competitivo y de alto nivel.
    </p>

    <div class="flex flex-col">
      {
        workshops.map((workshop) => (
          <article class="grid grid-cols-1 lg:grid-cols-[380px_1fr] gap-8 p-6 mb-6 rounded-xl bg-[#181818] border border-zinc-800/30">
            <a href={`/workshops/${workshop.slug}`} class="overflow-hidden aspect-[16/10] lg:aspect-auto lg:h-full">
              <img
                src={workshop.heroImage}
                alt={workshop.title}
                class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                loading="lazy"
              />
            </a>

            <div class="flex flex-col gap-5">
              <p class="flex flex-wrap gap-2 text-xs">
                <span class="bg-tars text-white px-3 py-1 uppercase tracking-wide">{workshop.category}</span>
                <span class="bg-tars-50 text-tars px-3 py-1 uppercase tracking-wide">{workshop.status}</span>
              </p>
              <h2 class="font-display font-extrabold text-3xl">{workshop.title}</h2>
              <p class="leading-relaxed text-ink/80">{workshop.summary}</p>

              <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">
                {workshop.date && (<div class="border-l-4 border-tars pl-3"><dt class="text-tars text-xs uppercase tracking-wide">Fecha</dt><dd>{workshop.date}</dd></div>)}
                {workshop.schedule && (<div class="border-l-4 border-tars pl-3"><dt class="text-tars text-xs uppercase tracking-wide">Horario</dt><dd>{workshop.schedule}</dd></div>)}
                {workshop.location && (<div class="border-l-4 border-tars pl-3"><dt class="text-tars text-xs uppercase tracking-wide">Lugar</dt><dd>{workshop.location}</dd></div>)}
                {workshop.partner && (<div class="border-l-4 border-tars pl-3"><dt class="text-tars text-xs uppercase tracking-wide">En colaboración con</dt><dd>{workshop.partner}</dd></div>)}
              </dl>

              {[
                { label: "Colaboran", items: workshop.partners },
                { label: "Patrocinan", items: workshop.sponsors },
              ].map((group) =>
                group.items && group.items.length > 0 && (
                  <div class="flex flex-col gap-2">
                    <span class="text-xs uppercase tracking-[0.15em] text-ink/50">{group.label}</span>
                    <div class="flex flex-wrap items-center gap-6">
                      {group.items.map((item) =>
                        item.logo ? (
                          <span class="flex items-center rounded-lg bg-white px-3 py-2"><img src={item.logo} alt={item.name} title={item.name} class="h-7 w-auto max-w-[120px] object-contain" loading="lazy" /></span>
                        ) : (
                          <span class="text-sm">{item.name}</span>
                        )
                      )}
                    </div>
                  </div>
                )
              )}

              <div class="mt-auto pt-2">
                <BrandButton href={`/workshops/${workshop.slug}`}>Ver taller completo</BrandButton>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </main>

  <Footer />
</Layout>
