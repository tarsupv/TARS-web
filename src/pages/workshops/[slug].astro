---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import DetailHero from "../../components/brand/DetailHero.astro";
import BrandButton from "../../components/brand/BrandButton.astro";
import WorkshopsData from "../../../public/json/workshops.json";

interface WorkshopEntity {
  name: string;
  role: string;
  logo?: string;
  url?: string;
}

interface Workshop {
  slug: string;
  title: string;
  category: string;
  status: string;
  date?: string;
  partner?: string;
  location?: string;
  schedule?: string;
  summary: string;
  description?: string[];
  heroImage: string;
  gallery?: string[];
  highlights?: string[];
  partners?: WorkshopEntity[];
  sponsors?: WorkshopEntity[];
  ctaLabel?: string;
  ctaUrl?: string;
}

export async function getStaticPaths() {
  const workshops = (WorkshopsData.workshops || []) as Workshop[];
  return workshops.map((workshop) => ({
    params: { slug: workshop.slug },
    props: { workshop },
  }));
}

const { workshop } = Astro.props as { workshop: Workshop };

const facts = [
  { label: "Fecha", value: workshop.date },
  { label: "Horario", value: workshop.schedule },
  { label: "Lugar", value: workshop.location },
  { label: "Colaboración principal", value: workshop.partner },
].filter((f) => f.value);

const entityGroups = [
  { label: "Colaboradores", items: workshop.partners ?? [] },
  { label: "Patrocinadores", items: workshop.sponsors ?? [] },
].filter((g) => g.items.length > 0);
---

<Layout
  title={`${workshop.title} | Talleres TARS`}
  description={workshop.summary}
  image={workshop.heroImage}
 
>
  <Header />
  <DetailHero
    image={workshop.heroImage}
    title={workshop.title}
    eyebrow="Taller TARS"
    summary={workshop.summary}
    tags={[workshop.category, workshop.status]}
    back={{ href: "/workshops", label: "Todos los talleres" }}
  />

  <main class="mx-auto max-w-6xl px-6 pt-16 flex flex-col gap-20">
    <section class="grid gap-12 lg:grid-cols-[1.5fr_1fr]">
      <article>
        <h2 class="font-display font-extrabold uppercase text-2xl mb-6">Sobre el taller</h2>
        <div class="flex flex-col gap-5 text-lg leading-relaxed text-ink/85">
          {(workshop.description || []).map((paragraph) => <p>{paragraph}</p>)}
        </div>
        {workshop.highlights && workshop.highlights.length > 0 && (
          <ul class="mt-8 flex flex-col gap-3">
            {workshop.highlights.map((h) => (
              <li class="flex gap-3"><span class="mt-2 w-2 h-2 shrink-0 bg-tars" />{h}</li>
            ))}
          </ul>
        )}
      </article>

      <aside class="flex flex-col gap-10">
        <div class="bg-tars-50 p-6 flex flex-col gap-4">
          <h2 class="text-tars text-xs font-semibold uppercase tracking-[0.15em]">Ficha rápida</h2>
          {facts.map((f) => (
            <div class="border-l-4 border-tars pl-4">
              <span class="block text-xs uppercase tracking-wide text-ink/55">{f.label}</span>
              <span>{f.value}</span>
            </div>
          ))}
          {workshop.ctaUrl && (
            <div class="pt-2">
              <BrandButton href={workshop.ctaUrl}>{workshop.ctaLabel || "Más información"}</BrandButton>
            </div>
          )}
        </div>

        {entityGroups.map((group) => (
          <div class="flex flex-col gap-4">
            <h2 class="text-tars text-xs font-semibold uppercase tracking-[0.15em]">{group.label}</h2>
            {group.items.map((item) => (
              <div class="flex items-center gap-4 border-b border-tars-100 pb-4">
                {item.logo && (
                  <div class="flex h-14 w-20 shrink-0 items-center justify-center rounded-lg bg-white p-2">
                    <img src={item.logo} alt="" class="max-h-10 max-w-full object-contain" loading="lazy" />
                  </div>
                )}
                <div>
                  <p class="font-medium">{item.name}</p>
                  <p class="text-sm text-ink/60">{item.role}</p>
                </div>
              </div>
            ))}
          </div>
        ))}
      </aside>
    </section>

    {workshop.gallery && workshop.gallery.length > 0 && (
      <section>
        <h2 class="font-display font-extrabold uppercase text-2xl mb-6">Galería</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {workshop.gallery.map((image, index) => (
            <img src={image} alt={`${workshop.title}, imagen ${index + 1}`} class="w-full aspect-[4/3] object-cover" loading="lazy" />
          ))}
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>
