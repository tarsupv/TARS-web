---
// Cabecera global: barra transparente que se oscurece al hacer scroll.
const homeSections = [
  { href: "/#top", label: "Inicio" },
  { href: "/#noticias", label: "Últimas noticias" },
  { href: "/#sobre-nosotros", label: "Sobre nosotros" },
  { href: "/#competiciones", label: "Competiciones" },
  { href: "/#iniciativas", label: "Iniciativas internas" },
  { href: "/#contacto", label: "Contacto" },
];

const partnerSections = [
  { href: "/partners#patrocinadores", label: "Patrocinadores" },
  { href: "/partners#entidades", label: "Entidades" },
];

const links = [
  { href: "/team", label: "Equipo" },
  { href: "/workshops", label: "Talleres" },
  { href: "/talleres", label: "UN Robotics" },
  { href: "/work", label: "Noticias" },
];

const socials = [
  { href: "https://www.instagram.com/tars.upv", icon: "/img/instagram.svg", label: "Instagram" },
  { href: "https://www.tiktok.com/@tars.upv", icon: "/img/tiktok.svg", label: "TikTok" },
  { href: "https://www.linkedin.com/company/105258034/", icon: "/img/linkedin.svg", label: "LinkedIn" },
  { href: "https://www.youtube.com/@TARSupv?sub_confirmation=1", icon: "/img/youtube.svg", label: "YouTube" },
  { href: "https://x.com/Tars_UPV", icon: "/img/twitter.svg", label: "X" },
];
---

<header
  id="siteHeader"
  class="old-header fixed top-0 inset-x-0 z-50 h-16 sm:h-20 text-white"
>
  <div class="h-full mx-auto max-w-7xl px-4 sm:px-8 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label="TARS Robotics, inicio">
      <img src="/img/brand/mascota-circulo.png" alt="" class="h-10 sm:h-12 w-auto" />
      <img src="/img/brand/wordmark-tars-robotics.png" alt="TARS Robotics" class="h-7 sm:h-9 w-auto" />
    </a>

    <nav class="hidden lg:flex items-center gap-1 text-sm font-medium">
      <div class="menu-wrap relative">
        <a href="/" class="nav-link">Inicio <span class="caret" aria-hidden="true"></span></a>
        <div class="dropdown">
          {homeSections.map((s) => <a href={s.href} class="dropdown-link">{s.label}</a>)}
        </div>
      </div>
      <a href={links[0].href} class="nav-link">{links[0].label}</a>
      <div class="menu-wrap relative">
        <a href="/partners" class="nav-link">Partners <span class="caret" aria-hidden="true"></span></a>
        <div class="dropdown">
          {partnerSections.map((s) => <a href={s.href} class="dropdown-link">{s.label}</a>)}
        </div>
      </div>
      {links.slice(1).map((l) => <a href={l.href} class="nav-link">{l.label}</a>)}
      <a href="/partners#patrocinadores" class="pixel-corners ml-3 px-3 py-1 bg-white text-black font-[SourceCodePro] text-sm hover:bg-transparent hover:text-white transition-all">
        Patrocina
      </a>
    </nav>

    <button
      id="menuToggle"
      class="lg:hidden p-2 -mr-2"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" />
      </svg>
    </button>
  </div>
</header>

<div
  id="mobileMenu"
  class="fixed inset-0 z-[60] bg-black/95 text-white hidden flex-col px-6 pt-5 pb-8 overflow-y-auto"
>
  <div class="flex items-center justify-between">
    <img src="/img/brand/wordmark-tars-robotics.png" alt="TARS Robotics" class="h-8 w-auto" />
    <button id="menuClose" class="p-2 -mr-2" aria-label="Cerrar menú">
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" />
      </svg>
    </button>
  </div>

  <nav class="mt-10 flex flex-col gap-1 font-bold text-2xl">
    <a href="/" class="py-2">Inicio</a>
    {homeSections.slice(1).map((s) => (
      <a href={s.href} class="py-1 pl-4 font-sans font-normal normal-case text-base text-white/75">{s.label}</a>
    ))}
    <a href={links[0].href} class="py-2 mt-3">{links[0].label}</a>
    <a href="/partners" class="py-2">Partners</a>
    {partnerSections.map((s) => (
      <a href={s.href} class="py-1 pl-4 font-sans font-normal normal-case text-base text-white/75">{s.label}</a>
    ))}
    {links.slice(1).map((l) => <a href={l.href} class="py-2">{l.label}</a>)}
  </nav>

  <div class="mt-auto pt-10 flex items-center gap-6">
    {socials.map((s) => (
      <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="opacity-80 hover:opacity-100">
        <img src={s.icon} alt="" class="h-6 w-6 invert" />
      </a>
    ))}
  </div>
</div>

<script>
  const header = document.getElementById("siteHeader");
  const menu = document.getElementById("mobileMenu");
  const toggle = document.getElementById("menuToggle");
  const close = document.getElementById("menuClose");

  const onScroll = () => header?.classList.toggle("scrolled", window.scrollY > 0);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const setMenu = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    menu?.classList.toggle("flex", open);
    toggle?.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  };
  toggle?.addEventListener("click", () => setMenu(true));
  close?.addEventListener("click", () => setMenu(false));
  // Los enlaces del menu movil llevan a anclas de la misma pagina: hay que
  // cerrar el menu o se queda tapando la seccion a la que se salta.
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
</script>

<style>
  .old-header {
    background: linear-gradient(180deg, rgba(8, 8, 8, 0.12) 0%, rgba(8, 8, 8, 0.02) 100%);
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(20px);
    transition: background-color 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .old-header.scrolled {
    background: rgba(8, 8, 8, 0.92);
    border-bottom-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border-radius: 8px;
    font-weight: 500;
    color: #fff;
    transition: background-color 0.15s;
  }
  .nav-link:hover {
    background-color: #6363633e;
    font-weight: 700;
  }

  .caret {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid currentColor;
    opacity: 0.7;
  }

  /* Desplegable por hover y por foco (teclado); el padding superior tiende un
     puente invisible para que no se cierre al bajar el raton. */
  .dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 230px;
    padding-top: 10px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
  }
  .menu-wrap:hover .dropdown,
  .menu-wrap:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .dropdown::before {
    content: "";
    position: absolute;
    inset: 10px 0 0 0;
    background: rgba(16, 16, 16, 0.95);
    border: 1px solid rgba(63, 63, 70, 0.8);
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    z-index: -1;
  }
  .dropdown-link {
    display: block;
    padding: 10px 16px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
    font-family: "SourceCodePro", monospace;
  }
  .dropdown-link:first-child {
    margin-top: 6px;
  }
  .dropdown-link:last-child {
    margin-bottom: 6px;
  }
  .dropdown-link:hover {
    background: linear-gradient(90deg, rgba(59, 130, 246, 0.12), rgba(147, 51, 234, 0.08));
    color: #fff;
  }
</style>
