---
import BrandButton from "./brand/BrandButton.astro";
import { footerSponsors } from "../lib/sponsors";
import { mail_llegada_correos_patrocinios } from "../lib/constants";

const currentYear = new Date().getFullYear();
const sponsorMailto = `mailto:${mail_llegada_correos_patrocinios}?subject=${encodeURIComponent(
  "Queremos formar parte de la familia TARS Robotics UPV"
)}`;

// El carrusel se desplaza la mitad de su ancho y vuelve a empezar, asi que cada
// mitad tiene que llenar la pantalla aunque haya pocos patrocinadores.
const sponsors = footerSponsors();
const repeats = sponsors.length ? Math.max(1, Math.ceil(8 / sponsors.length)) : 0;
const strip = Array.from({ length: repeats }, () => sponsors).flat();
const duration = Math.max(20, strip.length * 4);

const socials = [
  { href: "https://www.instagram.com/tars.upv", icon: "/img/instagram.svg", label: "Instagram" },
  { href: "https://www.tiktok.com/@tars.upv", icon: "/img/tiktok.svg", label: "TikTok" },
  { href: "https://www.linkedin.com/company/105258034/", icon: "/img/linkedin.svg", label: "LinkedIn" },
  { href: "https://www.youtube.com/@TARSupv?sub_confirmation=1", icon: "/img/youtube.svg", label: "YouTube" },
  { href: "https://x.com/Tars_UPV", icon: "/img/twitter.svg", label: "X" },
];
---

<footer class="relative mt-28 overflow-hidden bg-gradient-to-tr from-[#1c1832] to-[#481b72] text-white">
  <div class="scrolling-text-container" aria-hidden="true">
    <div class="scrolling-text">Innovacion y excelencia en robotica competitiva</div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1400px] px-6 md:px-16 py-12 flex flex-col gap-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-end">
      <div class="flex flex-row flex-wrap items-center gap-6">
        <div class="flex flex-row items-center gap-3">
          <img src="/img/brand/mascota-circulo.png" alt="" class="h-14 w-auto" />
          <img src="/img/brand/wordmark-tars-robotics.png" alt="TARS Robotics" class="h-10 w-auto" />
        </div>
        <div class="w-[2px] h-10 bg-white/30"></div>
        <img src="/img/brand/logo-upv-blanco.png" alt="Universitat Politècnica de València" class="h-10 w-auto" />
        <img src="/img/brand/logo-generacion-espontanea-blanco.png" alt="Generación Espontánea · UPV Design Factory" class="h-10 w-auto" />
      </div>
      <div class="flex flex-col gap-4 lg:items-end">
        <h3 class="text-xl font-medium lg:text-right">Innovación y excelencia en robótica competitiva</h3>
        <div class="flex flex-row gap-3 lg:justify-end">
          <BrandButton href="https://forms.gle/UZZHY9VspfVWfafUA" variant="light" external>Únete</BrandButton>
          <BrandButton href={sponsorMailto}>Patrocinar</BrandButton>
        </div>
      </div>
    </div>

    {
      sponsors.length > 0 && (
        <div class="sponsor-marquee relative overflow-hidden rounded-xl border border-white/10 bg-black/30 py-4" aria-label="Patrocinadores">
          <div class="sponsor-track flex w-max items-center" style={`--duration:${duration}s`}>
            {[0, 1].map((half) => (
              <div class="flex items-center gap-4 pr-4" aria-hidden={half === 1 ? "true" : undefined}>
                {strip.map((s) => (
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={s.name}
                    tabindex={half === 1 ? -1 : undefined}
                    class="flex items-center justify-center rounded-lg bg-white px-4 py-2 opacity-80 hover:opacity-100 transition-opacity"
                  >
                    <img src={s.logo} alt={half === 1 ? "" : s.name} style={`height:${s.logoHeight}px`} class="w-auto max-w-[220px] object-contain" loading="lazy" />
                  </a>
                ))}
              </div>
            ))}
          </div>
        </div>
      )
    }

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <p>&copy; {currentYear} TARS UPV. Todos los derechos reservados.</p>
      <div class="invert flex flex-row items-center gap-6">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="opacity-60 hover:opacity-100">
            <img src={s.icon} alt="" class="w-6 h-6" />
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .sponsor-track {
    animation: sponsor-scroll var(--duration) linear infinite;
  }
  .sponsor-marquee:hover .sponsor-track {
    animation-play-state: paused;
  }
  @keyframes sponsor-scroll {
    to {
      transform: translateX(-50%);
    }
  }
  .scrolling-text-container {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #1a1a1a30;
  }
  .scrolling-text {
    font-size: 20rem;
    font-weight: bolder;
    font-family: "SourceCodePro", monospace;
    color: transparent;
    -webkit-text-stroke: 5px rgba(255, 255, 255, 0.03);
    white-space: nowrap;
    animation: scroll 300s linear infinite;
  }
  @keyframes scroll {
    0% { transform: translateX(100%); }
    100% { transform: translateX(-100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sponsor-track,
    .scrolling-text {
      animation: none;
    }
  }
</style>
