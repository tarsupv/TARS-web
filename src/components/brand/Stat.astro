---
// Cifra destacada del dossier: numero grande en azul y peso ligero, con su
// explicacion al lado o debajo.
interface Props {
  value: string;
  label: string;
  detail?: string;
}
const { value, label, detail } = Astro.props;
---

<div class="flex flex-col gap-2">
  <span class="text-tars text-4xl sm:text-5xl font-normal leading-none whitespace-nowrap">{value}</span>
  <span class="text-ink font-medium">{label}</span>
  {detail && <span class="text-ink/70 text-sm leading-relaxed">{detail}</span>}
</div>
