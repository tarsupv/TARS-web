---
// VERSION DE COMPARACION: boton pixelado de la web antigua (Source Code Pro,
// esquinas en escalera, flecha que aparece al pasar el raton).
interface Props {
  href: string;
  variant?: "solid" | "light" | "ghost" | "ghost-light";
  external?: boolean;
  class?: string;
}

const { href, variant = "solid", external = false, class: className = "" } = Astro.props;
const filled = variant === "light";
---

<a
  href={href}
  {...external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
  class={`old-btn pixel-corners group inline-flex items-center px-3 py-1 text-lg font-medium font-[SourceCodePro] transition-all ${
    filled ? "bg-white text-black" : "bg-transparent text-white hover:bg-white hover:text-black"
  } ${className}`}
>
  <slot />
  <svg class="old-btn-arrow w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M4 11v2h12v2h2v-2h2v-2h-2V9h-2v2H4zm10-4h2v2h-2V7zm0 0h-2V5h2v2zm0 10h2v-2h-2v2zm0 0h-2v2h2v-2z" />
  </svg>
</a>

<style>
  .old-btn {
    transition: all 0.3s cubic-bezier(0, 0, 0, 1);
  }
  .old-btn-arrow {
    width: 0;
    margin-left: 0;
    opacity: 0;
    transition: all 0.3s cubic-bezier(0, 0, 0, 1);
  }
  .old-btn:hover .old-btn-arrow {
    width: 20px;
    margin-left: 18px;
    opacity: 1;
  }
</style>
