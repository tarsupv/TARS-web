---
// Ficha de detalle (talleres, iniciativas): tarjeta oscura con la foto y
// degradado, y el texto con la tipografia del dossier.
interface Props {
  image: string;
  title: string;
  eyebrow: string;
  summary?: string;
  tags?: string[];
  back: { href: string; label: string };
}
const { image, title, eyebrow, summary, tags = [], back } = Astro.props;
---

<div class="mx-auto max-w-[1400px] px-4 sm:px-10 pt-28 flex flex-col gap-10">
  <div>
    <a href={back.href} class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.03] px-4 py-2 text-sm text-white/75 transition-colors hover:bg-white/[0.06] hover:text-white">
      <img src="https://unpkg.com/pixelarticons@1.8.1/svg/arrow-left.svg" alt="" class="h-4 w-4 invert" />
      {back.label}
    </a>
  </div>
  <section class="overflow-hidden rounded-[28px] border border-zinc-800/50 bg-[#111111]">
    <div class="relative min-h-[380px]">
      <img src={image} alt="" class="absolute inset-0 h-full w-full object-cover" />
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(7,7,7,0.15),rgba(7,7,7,0.9))]"></div>
      <div class="relative flex min-h-[380px] flex-col justify-end gap-6 p-8 sm:p-12">
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 text-sm">
            {tags.map((tag, i) => (
              <span class={`rounded-full border px-3 py-1 ${i === 1 ? "border-emerald-400/20 bg-emerald-500/15 text-emerald-300" : "border-white/15 bg-white/10 text-white"}`}>{tag}</span>
            ))}
          </div>
        )}
        <div class="max-w-4xl">
          <p class="mb-3 font-wide uppercase tracking-[0.25em] text-white/80 text-sm">{eyebrow}</p>
          <h1 class="font-display font-extrabold text-4xl text-white sm:text-6xl leading-tight">{title}</h1>
          {summary && <p class="mt-4 max-w-3xl text-lg leading-relaxed text-white/85 font-light">{summary}</p>}
        </div>
      </div>
    </div>
  </section>
</div>
